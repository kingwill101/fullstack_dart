{% layout "layouts/base" %}

{% block content %}
  <section class="mx-auto max-w-2xl rounded-3xl border border-ink/10 bg-white/80 p-8 shadow-xl">
    <p class="text-xs uppercase tracking-[0.3em] text-ember">Queued with Stem</p>
    <h1 class="mt-4 font-display text-5xl">{{ app_title }}</h1>
    <p class="mt-4 text-ink/70">Subscribe to queue a Liquify-rendered welcome email.</p>
    <form id="subscribe" class="mt-8 flex gap-3">
      <input id="email" type="email" required placeholder="you@example.com" class="flex-1 rounded-xl border px-4 py-3" />
      <button class="rounded-xl bg-moss px-5 py-3 font-semibold text-white">Subscribe</button>
    </form>
    <p id="status" class="mt-4 text-sm"></p>
  </section>
  <script>
    document.getElementById('subscribe').addEventListener('submit', async (event) => {
      event.preventDefault();
      const email = document.getElementById('email').value;
      const response = await fetch('/api/subscriptions', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({email}),
      });
      document.getElementById('status').textContent = response.ok
        ? 'Welcome email queued.'
        : 'Please enter a valid email.';
    });
  </script>
{% endblock %}
